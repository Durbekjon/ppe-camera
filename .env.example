# Copy to .env and fill in. Never commit .env.

# Video source: webcam index (0, 1, ...), a stream URL, or a video file path.
#   Phone as IP camera (e.g. "IP Webcam" on Android):  http://192.168.1.50:8080/video
#   RTSP camera:                                        rtsp://user:pass@192.168.1.60:554/stream
#   iPhone via macOS Continuity Camera shows up as a webcam index (usually 1).
VIDEO_SOURCE=0
# Up to 4 cameras instead of VIDEO_SOURCE, as Name=source separated by ";". Zones and incidents are stored
# under the name. The first camera takes over zones drawn before.
# CAMERAS=Kirish=0;Sex=rtsp://user:pass@192.168.1.60:554/stream

# 1 = start on the offline demo video instead of the camera (can also be toggled in the dashboard).
DEMO_MODE=0
# DEMO_VIDEO=data/demo.mp4

# Telegram alerts (leave empty to disable). Create a bot with @BotFather; get the chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Detection tuning
# REQUIRE_VEST=1        # also alert on a missing vest
# HELMET_RULE=explicit  # alert only when a bare head is positively detected (fewer false alarms, more misses)
# IMG_SIZE=480          # lower (416) = faster, higher (640) = better on small/distant people
# DEBOUNCE_S=1.5
# COOLDOWN_S=15
# RESOLVE_S=5           # seconds with the helmet on before the violation counts as over
# REJOIN_S=10           # a lost worker reappearing nearby within this time is not counted again
# TELEGRAM_GROUP_S=5    # ordinary alerts within this window share one Telegram message
# BLUR_FACES=1          # blur faces in saved and Telegram snapshots
# RETENTION_DAYS=30     # delete snapshots older than this (0 = keep forever)
# SAVE_RAW=1            # keep a clean blurred frame per incident for false-alarm export
# PORT=8000

# Access from other computers needs HTTPS: run tools/make_cert.sh <this computer's IP>, then set:
# HOST=0.0.0.0
# TLS_CERT=data/certs/cert.pem
# TLS_KEY=data/certs/key.pem
